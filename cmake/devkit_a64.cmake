set(CMAKE_SYSTEM_NAME Generic)
set(CMAKE_SYSTEM_PROCESSOR aarch64)
set(CMAKE_TRY_COMPILE_TARGET_TYPE STATIC_LIBRARY)
if(NOT DEFINED DEVKITPRO)
    if(DEFINED ENV{DEVKITPRO})
        set(DEVKITPRO "$ENV{DEVKITPRO}")
    elseif(CMAKE_HOST_WIN32)
        set(DEVKITPRO "C:/devkitPro")
    else()
        set(DEVKITPRO "/opt/devkitpro")
    endif()
endif()
if(CMAKE_HOST_WIN32)
    set(YW1_TOOL_SUFFIX ".exe")
else()
    set(YW1_TOOL_SUFFIX "")
endif()
set(CMAKE_CXX_COMPILER "${DEVKITPRO}/devkitA64/bin/aarch64-none-elf-g++${YW1_TOOL_SUFFIX}")
set(CMAKE_AR "${DEVKITPRO}/devkitA64/bin/aarch64-none-elf-ar${YW1_TOOL_SUFFIX}")
set(CMAKE_RANLIB "${DEVKITPRO}/devkitA64/bin/aarch64-none-elf-ranlib${YW1_TOOL_SUFFIX}")
set(CMAKE_CXX_FLAGS_INIT "-march=armv8-a -mtune=cortex-a57 -ffunction-sections -fdata-sections")
