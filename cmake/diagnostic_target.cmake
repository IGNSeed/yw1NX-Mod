# 完成したNSOとELFから、このpairだけを読めるNROの定数を生成する。
execute_process(COMMAND "${NM}" -S --defined-only "${ELF}"
    RESULT_VARIABLE result OUTPUT_VARIABLE symbols)
if(NOT result EQUAL 0)
    message(FATAL_ERROR "Cannot inspect the diagnostic ELF")
endif()
set(diagnostic_symbols yw1_module_identity yw1_module_diagnostics_state
    yw1_module_log_header yw1_module_log_words)
if(EGL_DIAGNOSTIC)
    list(APPEND diagnostic_symbols yw1_egl_diagnostics)
endif()
if(CALLBACK_DIAGNOSTIC)
    list(APPEND diagnostic_symbols yw1_callback_diagnostics)
endif()
if(CONTEXT_DIAGNOSTIC)
    list(APPEND diagnostic_symbols yw1_context_diagnostics)
endif()
foreach(name IN LISTS diagnostic_symbols)
    string(REGEX MATCH "([0-9a-fA-F]+) ([0-9a-fA-F]+) [A-Za-z] ${name}(\n|$)" row "${symbols}")
    if(NOT row)
        message(FATAL_ERROR "Missing diagnostic symbol ${name}")
    endif()
    set(${name}_offset "0x${CMAKE_MATCH_1}")
    set(${name}_size "0x${CMAKE_MATCH_2}")
endforeach()
file(READ "${NSO}" build_id OFFSET 64 LIMIT 32 HEX)
string(LENGTH "${build_id}" length)
if(NOT length EQUAL 64)
    message(FATAL_ERROR "Invalid NSO Build ID")
endif()
set(bytes "")
foreach(index RANGE 0 31)
    math(EXPR start "${index} * 2")
    string(SUBSTRING "${build_id}" ${start} 2 byte)
    string(APPEND bytes "0x${byte},")
endforeach()
get_filename_component(directory "${OUTPUT}" DIRECTORY)
file(MAKE_DIRECTORY "${directory}")
file(WRITE "${OUTPUT}" "#pragma once\n#include <cstdint>\nnamespace yw1::companion {\n"
    "inline constexpr std::uint8_t k${PREFIX}ExpectedModuleId[32]{${bytes}};\n"
    "inline constexpr std::uint64_t k${PREFIX}IdentityOffset=${yw1_module_identity_offset};\n"
    "inline constexpr std::uint64_t k${PREFIX}StateOffset=${yw1_module_diagnostics_state_offset};\n"
    "inline constexpr std::uint64_t k${PREFIX}StateSize=${yw1_module_diagnostics_state_size};\n"
    "inline constexpr std::uint64_t k${PREFIX}ExportHeaderOffset=${yw1_module_log_header_offset};\n"
    "inline constexpr std::uint64_t k${PREFIX}ExportDataOffset=${yw1_module_log_words_offset};\n}\n")
if(EGL_DIAGNOSTIC)
    file(APPEND "${OUTPUT}" "namespace yw1::companion { inline constexpr std::uint64_t k${PREFIX}EglOffset=${yw1_egl_diagnostics_offset}; }\n")
endif()
if(CALLBACK_DIAGNOSTIC)
    file(APPEND "${OUTPUT}" "namespace yw1::companion { inline constexpr std::uint64_t k${PREFIX}CallbackOffset=${yw1_callback_diagnostics_offset}; }\n")
endif()
if(CONTEXT_DIAGNOSTIC)
    file(APPEND "${OUTPUT}" "namespace yw1::companion { inline constexpr std::uint64_t kContextOffset=${yw1_context_diagnostics_offset}; }\n")
endif()
